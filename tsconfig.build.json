{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "components",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["components/**/*.ts", "components/**/*.tsx"],
  "exclude": ["**/*.stories.ts", "**/*.stories.tsx"]
}